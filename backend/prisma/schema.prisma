generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  // Relation: A user can have many uploaded files
  files   File[]
  folders Folder[] // Relation: User has many folders
}

model Folder {
  id   String @id @default(uuid())
  name String

  // Relation to User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Subfolder Relation using folderId
  folderId String?
  parent   Folder?  @relation("FolderHierarchy", fields: [folderId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderHierarchy")

  // Relation to File
  files File[] // Relation: Folder has many files

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint so user cannot have two folders with the same name
  @@unique([name, userId])
}

model File {
  id           String @id @default(uuid())
  originalName String
  storedName   String @unique // Stores Cloudinary public_id (useful for file deletion!)
  mimeType     String
  size         Int // File size in bytes
  url          String // Cloudinary url

  // Relation to User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relation to Folder (null = root level)
  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
